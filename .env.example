POSTGRES_USER=outfit
POSTGRES_PASSWORD=outfit
POSTGRES_DB=dripfind
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_SSLMODE=disable

HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:3000
IMAGES_DIR=images
MIGRATE_ON_START=true

# Leave empty to use demo vision mode with sample outfit detection
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: enrich product results via SerpAPI Google Shopping
SERPAPI_KEY=

# Force demo vision even if OPENAI_API_KEY is set
DEMO_MODE=false

NEXT_PUBLIC_API_URL=http://localhost:8080

# Auth
SESSION_SECRET=dev-session-secret-change-me
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# Durable job queue (worker process)
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=3

# Object storage (MinIO / S3). Use STORAGE_BACKEND=local to keep disk files.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dripfind
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/dripfind
S3_FORCE_PATH_STYLE=true

# Google OAuth (optional — leave empty to disable Google button functionality)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email OTP via SMTP (optional — without this, OTP codes are logged by the API)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DRIPFIND <noreply@dripfind.local>
